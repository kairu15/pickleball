# Keep secrets and local junk out of the build context.
.env
.env.*
!.env.example

# Version control and CI
.git
.github

# Python artifacts
__pycache__
*.py[cod]
*.egg-info
.venv
venv

# Django artifacts (rebuilt inside the image)
staticfiles
media
db.sqlite3

# Tooling caches
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Editors / OS
.vscode
.idea
.DS_Store

# Docs not needed at runtime
AUDIT.md
