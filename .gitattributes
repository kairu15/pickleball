* text=auto

# Shell scripts must keep LF endings or Linux containers break
# (/bin/sh^M: bad interpreter).
*.sh text eol=lf
docker/entrypoint.sh text eol=lf

# Python and web sources: normalize to LF in the repo.
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Windows-only files
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.sqlite3 binary
