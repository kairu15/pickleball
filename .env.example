# ============================================================================
# PickleSphere - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================================
# cp .env.example .env
#
# For production deployment checklist:
#  1. Generate a strong SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(50))"
#  2. Set DEBUG=False
#  3. Add your domain(s) to ALLOWED_HOSTS
#  4. Set SESSION_COOKIE_SECURE=True and CSRF_COOKIE_SECURE=True if using HTTPS
#  5. Configure your production database (PostgreSQL recommended)
#  6. Get Stripe API keys for payment processing
#  7. Configure email backend (SMTP or Elastic Email)
# ============================================================================

# ============================================================================
# Django Core Settings
# ============================================================================
# SECURITY WARNING: Generate a unique secret key for production!
# Run: python -c "import secrets; print(secrets.token_urlsafe(50))"
# NOTE: settings.py falls back to an insecure CI-only key when unset, but
# refuses to start with DEBUG=False unless a real key is provided.
# For local development, you can use:
#   SECRET_KEY=django-insecure-dev-key-not-for-production
SECRET_KEY=

# SECURITY WARNING: Don't run with debug turned on in production!
DEBUG=False

# Comma-separated list of allowed hosts
# For production: ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Site URL (used in emails, links, and CSRF_TRUSTED_ORIGINS)
# For production: SITE_URL=https://yourdomain.com
# For local dev: leave as http://localhost:8000
SITE_URL=http://localhost:8000

# ============================================================================
# Settings module selection
# ============================================================================
# picklesphere.settings is a package now. DJANGO_ENV picks the module:
#   dev  (default) - debug conveniences, SQLite-friendly, eager Celery
#   prod           - hardened; fails fast on insecure configuration
# Alternatively point DJANGO_SETTINGS_MODULE at a specific module, e.g.
#   DJANGO_SETTINGS_MODULE=picklesphere.settings.prod
# DJANGO_ENV=dev

# ============================================================================
# Database (PostgreSQL recommended for production)
# ============================================================================
# For SQLite (development only), no extra config needed.
#
# For PostgreSQL (production - and what docker-compose.yml provides), set:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=picklesphere
# DB_USER=picklesphere
# DB_PASSWORD=picklesphere-dev-password
# DB_HOST=db
# DB_PORT=5432
#
# (DB_HOST=db is the compose service name; use localhost for a local Postgres.)

# ============================================================================
# Security Settings
# ============================================================================
# Set to True in production when serving over HTTPS
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Production security headers. Each defaults to "on when DEBUG=False" and can
# be overridden here per-environment.
# Redirect all plain-HTTP requests to HTTPS. Set False if a proxy/health check
# talks plain HTTP to the app server.
# SECURE_SSL_REDIRECT=True
# HTTP Strict Transport Security, in seconds (31536000 = 1 year). Set 0 to disable.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# Referrer-Policy header value.
# SECURE_REFERRER_POLICY=same-origin

# ============================================================================
# Stripe Payment Gateway
# ============================================================================
# Get your keys from https://dashboard.stripe.com/apikeys
# Use test keys (pk_test_... / sk_test_...) for development
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================================
# Email Configuration
# ============================================================================
# For development (prints emails to console):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# For production with SMTP:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=your-email@gmail.com
#   EMAIL_HOST_PASSWORD=your-app-password
#
# For Elastic Email (transactional):
#   Get API key from https://elasticemail.com
#   Setting ELASTICEMAIL_API_KEY overrides EMAIL_BACKEND automatically

# From address used in all outgoing emails
DEFAULT_FROM_EMAIL=noreply@picklesphere.com
DEFAULT_FROM_NAME=PickleSphere

# Elastic Email API key (overrides EMAIL_BACKEND when set)
ELASTICEMAIL_API_KEY=

# ============================================================================
# Redis, Celery and Channels
# ============================================================================
# REDIS_URL feeds the channel layer, Celery broker/results, and (with
# CACHE_BACKEND=redis) the cache. In dev, leave everything unset: tasks run
# inline and caches/channel layers fall back to in-memory.
# REDIS_URL=redis://redis:6379/0
# CACHE_BACKEND=redis
# CHANNEL_LAYER_BACKEND=redis
#
# Celery broker/result backends default to REDIS_URL; override if needed:
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============================================================================
# Optional: Sentry Error Tracking
# ============================================================================
# SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ============================================================================
# Production Deployment Quick Command
# ============================================================================
# After copying this file to .env and filling values, run:
#   python -c "import secrets; key=secrets.token_urlsafe(50); print(f'SECRET_KEY={key}')"
# Then paste the output into your .env file (replacing the placeholder).
